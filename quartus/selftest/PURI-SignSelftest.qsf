# Standalone DE10-Nano self-test, public development key d=1.
# Pin source: Terasic DE10-Nano User Manual, tables 3-5/3-7/3-8/3-10.
# https://fpgacademy.org/Downloads/DE10_Nano_User_Manual.pdf
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY tinysign_de10nano_selftest
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE PURI-SignSelftest.sdc
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name VERILOG_FILE ../../rtl/arithmetic/mod_add.v
set_global_assignment -name VERILOG_FILE ../../rtl/arithmetic/mod_inv.v
set_global_assignment -name VERILOG_FILE ../../rtl/arithmetic/mod_mul.v
set_global_assignment -name VERILOG_FILE ../../rtl/arithmetic/mod_sub.v
set_global_assignment -name VERILOG_FILE ../../rtl/arithmetic/montgomery_mul.v
set_global_assignment -name VERILOG_FILE ../../rtl/ec/point_add.v
set_global_assignment -name VERILOG_FILE ../../rtl/ec/point_double.v
set_global_assignment -name VERILOG_FILE ../../rtl/ec/point_ops.v
set_global_assignment -name VERILOG_FILE ../../rtl/ecdsa/ecdsa_signer.v
set_global_assignment -name VERILOG_FILE ../../rtl/ecdsa/scalar_mult.v
set_global_assignment -name VERILOG_FILE ../../rtl/nonce/hmac_sha256.v
set_global_assignment -name VERILOG_FILE ../../rtl/nonce/rfc6979.v
set_global_assignment -name VERILOG_FILE ../../rtl/platform/tinysign_de10nano.v
set_global_assignment -name VERILOG_FILE ../../rtl/platform/tinysign_de10nano_selftest.v
set_global_assignment -name VERILOG_FILE ../../rtl/security/key_manager.v
set_global_assignment -name VERILOG_FILE ../../rtl/security/tinysign_core.v
set_global_assignment -name VERILOG_FILE ../../rtl/sha256/sha256_compress.v
set_global_assignment -name VERILOG_FILE ../../rtl/sha256/sha256_hash.v
set_global_assignment -name VERILOG_FILE ../../rtl/test_support/selftest_uart_report.v
set_global_assignment -name VERILOG_FILE ../../rtl/test_support/tinysign_board_selftest.v
set_global_assignment -name VERILOG_FILE ../../rtl/test_support/uart_tx.v
set_location_assignment PIN_V11 -to {FPGA_CLK1_50}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {FPGA_CLK1_50}
set_location_assignment PIN_AH17 -to {KEY0_N}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {KEY0_N}
set_location_assignment PIN_W15 -to {LED[0]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {LED[0]}
set_location_assignment PIN_AA24 -to {LED[1]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {LED[1]}
set_location_assignment PIN_V16 -to {LED[2]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {LED[2]}
set_location_assignment PIN_V15 -to {LED[3]}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {LED[3]}
set_location_assignment PIN_V12 -to {GPIO0_TX}
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to {GPIO0_TX}

